rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- المهام ----
    match /users/{userId}/tasks/{taskId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['title','description','dueDate','dueTime','priority','category','notes','completed','createdAt','planStart','planDur'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.completed == false
        && (!('planDur' in request.resource.data) || (request.resource.data.planDur is int && request.resource.data.planDur >= 5 && request.resource.data.planDur <= 720));
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','dueDate','dueTime','priority','category','notes','completed','planStart','planDur','rewarded','focusMin','doneDay','board'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.completed is bool
        && (!('rewarded' in request.resource.data) || request.resource.data.rewarded is bool)
        && (!('focusMin' in request.resource.data) || request.resource.data.focusMin is int)
        && (!('doneDay' in request.resource.data) || request.resource.data.doneDay is string)
        && (!('board' in request.resource.data) || request.resource.data.board in ['todo','doing'])
        && (!('planDur' in request.resource.data) || (request.resource.data.planDur is int && request.resource.data.planDur >= 5 && request.resource.data.planDur <= 720));
    }

    // ---- جلسات وضع التركيز ----
    match /users/{userId}/focus/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['minutes','taskId','taskTitle','day','endedAt'])
        && request.resource.data.minutes is int && request.resource.data.minutes >= 1 && request.resource.data.minutes <= 180
        && request.resource.data.day is string;
    }

    // ---- ملخص اليوم (مزاج + ملاحظة) ----
    match /users/{userId}/wraps/{day} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['mood','note','updatedAt'])
        && request.resource.data.mood is int && request.resource.data.mood >= 0 && request.resource.data.mood <= 5
        && request.resource.data.note is string && request.resource.data.note.size() <= 500;
    }

    // ---- المكافآت (XP / مستويات / شارات) ----
    match /users/{userId}/stats/rewards {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['xp','streak','bestStreak','lastDay','lastClearDay','clears','tasksDone','focusSessions','focusMinutes','habitsDone','habitDays','lastHabitDay','goalsDone','expenseDays','lastExpenseDay','badges','recent','prayerDays','sunnahDays','adhkarSets','naflDone','wirdDays','khatmasDone','onceDay','once','islStreak','bestIslStreak','lastIslDay','updatedAt'])
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.badges is list && request.resource.data.recent is list && request.resource.data.recent.size() <= 12;
    }

    // ---- العادات (done = قائمة أيام YYYY-MM-DD، paid = أيام تم منح XP عنها) ----
    match /users/{userId}/habits/{habitId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name','icon','color','days','start','done','paid','remind','createdAt'])
        && (!('remind' in request.resource.data) || (request.resource.data.remind is string && request.resource.data.remind.size() <= 5))
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.days is list && request.resource.data.days.size() <= 7
        && request.resource.data.done is list && request.resource.data.done.size() <= 2000
        && request.resource.data.paid is list && request.resource.data.paid.size() <= 2000;
    }

    // ---- الملاحظات ----
    match /users/{userId}/notes/{noteId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['title','body','category','pinned','taskId','createdAt','updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 5000
        && request.resource.data.title.size() + request.resource.data.body.size() > 0
        && request.resource.data.pinned is bool
        && request.resource.data.taskId is string;
    }

    // ---- الأهداف (milestones: [{id,title,done,taskIds}]) ----
    match /users/{userId}/goals/{goalId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['title','description','type','period','icon','milestones','taskIds','rewarded','createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.type in ['month','year']
        && request.resource.data.period is string
        && request.resource.data.milestones is list && request.resource.data.milestones.size() <= 20
        && request.resource.data.taskIds is list && request.resource.data.taskIds.size() <= 200;
    }

    // ---- المصروفات والدخل ----
    match /users/{userId}/expenses/{txId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['type','amount','category','note','date','createdAt'])
        && request.resource.data.type in ['expense','income']
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000
        && request.resource.data.category is string && request.resource.data.category.size() <= 30
        && request.resource.data.note is string && request.resource.data.note.size() <= 120
        && request.resource.data.date is string && request.resource.data.date.size() == 10;
    }

    // ---- الميزانية الشهرية (limits: {تصنيف: مبلغ}) ----
    match /users/{userId}/finance/budget {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['limits','updatedAt'])
        && request.resource.data.limits is map;
    }

    // ---- تصنيفات المصروفات المخصصة (items: [{type,name,icon,color}]) ----
    match /users/{userId}/finance/categories {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['items','updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 40;
    }

    // ---- أجهزة Push (token لكل جهاز) ----
    match /users/{userId}/devices/{deviceId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['token','tz','ua','updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() <= 4096
        && request.resource.data.tz is string && request.resource.data.tz.size() <= 64;
    }

    // ---- إسلاميات: settings (مدينة/تنبيه/هدف/ختمة) + p_يوم (صلوات) + a_يوم (أذكار) + q_يوم (ورد) ----
    match /users/{userId}/islamic/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['city','adhan','goal','page','khatmas','done','sunnah','counts','pages','qbm','qfont','qtj','qtjSeen','qhz','hz','tasbih','tgoal','fast','fremind','cadhkar','adhanVoice','updatedAt'])
        && (!('city' in request.resource.data) || (request.resource.data.city is map && request.resource.data.city.name is string && request.resource.data.city.name.size() <= 40
            && request.resource.data.city.lat is number && request.resource.data.city.lng is number))
        && (!('adhan' in request.resource.data) || request.resource.data.adhan is bool)
        && (!('goal' in request.resource.data) || (request.resource.data.goal is int && request.resource.data.goal >= 1 && request.resource.data.goal <= 604))
        && (!('page' in request.resource.data) || (request.resource.data.page is int && request.resource.data.page >= 0 && request.resource.data.page <= 604))
        && (!('khatmas' in request.resource.data) || (request.resource.data.khatmas is int && request.resource.data.khatmas >= 0 && request.resource.data.khatmas <= 1000))
        && (!('done' in request.resource.data) || (request.resource.data.done is list && request.resource.data.done.size() <= 5))
        && (!('sunnah' in request.resource.data) || (request.resource.data.sunnah is list && request.resource.data.sunnah.size() <= 12))
        && (!('counts' in request.resource.data) || request.resource.data.counts is map)
        && (!('pages' in request.resource.data) || (request.resource.data.pages is int && request.resource.data.pages >= 0 && request.resource.data.pages <= 1208))
        && (!('qbm' in request.resource.data) || (request.resource.data.qbm is map && request.resource.data.qbm.keys().hasOnly(['s','a']) && request.resource.data.qbm.s is int && request.resource.data.qbm.s >= 1 && request.resource.data.qbm.s <= 114 && request.resource.data.qbm.a is int && request.resource.data.qbm.a >= 1 && request.resource.data.qbm.a <= 286))
        && (!('qfont' in request.resource.data) || (request.resource.data.qfont is int && request.resource.data.qfont >= 18 && request.resource.data.qfont <= 56))
        && (!('qtj' in request.resource.data) || request.resource.data.qtj is bool)
        && (!('qtjSeen' in request.resource.data) || request.resource.data.qtjSeen is bool)
        && (!('qhz' in request.resource.data) || request.resource.data.qhz is map)
        && (!('tasbih' in request.resource.data) || (request.resource.data.tasbih is int && request.resource.data.tasbih >= 0 && request.resource.data.tasbih <= 100000))
        && (!('tgoal' in request.resource.data) || (request.resource.data.tgoal is int && request.resource.data.tgoal >= 1 && request.resource.data.tgoal <= 10000))
        && (!('fast' in request.resource.data) || request.resource.data.fast is bool)
        && (!('fremind' in request.resource.data) || request.resource.data.fremind is bool)
        && (!('cadhkar' in request.resource.data) || (request.resource.data.cadhkar is list && request.resource.data.cadhkar.size() <= 20))
        && (!('adhanVoice' in request.resource.data) || request.resource.data.adhanVoice is string)
        && (!('hz' in request.resource.data) || (request.resource.data.hz is int && request.resource.data.hz >= 0 && request.resource.data.hz <= 100000));
    }

    // ---- تفضيلات الأدوات (إعدادات مؤقّت التركيز: المدد والصوت وعدد الدورات) ----
    match /users/{userId}/prefs/focus {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['dur','sound','cycles','updatedAt'])
        && (!('dur' in request.resource.data) || (request.resource.data.dur is map && request.resource.data.dur.keys().hasOnly(['focus','short','long'])
            && request.resource.data.dur.focus is int && request.resource.data.dur.focus >= 1 && request.resource.data.dur.focus <= 180
            && request.resource.data.dur.short is int && request.resource.data.dur.short >= 1 && request.resource.data.dur.short <= 180
            && request.resource.data.dur.long is int && request.resource.data.dur.long >= 1 && request.resource.data.dur.long <= 180))
        && (!('sound' in request.resource.data) || request.resource.data.sound is bool)
        && (!('cycles' in request.resource.data) || (request.resource.data.cycles is int && request.resource.data.cycles >= 0 && request.resource.data.cycles <= 100000));
    }

    // ---- الألعاب: Username عام فريد + ملفات + أصدقاء + أسماء اللاعبين ----
    function signedIn() { return request.auth != null; }
    function pref(u) { return /databases/$(database)/documents/profiles/$(u); }
    function uref(k) { return /databases/$(database)/documents/usernames/$(k); }
    function okGame(g) { return g in ['memory','xo','chess','hangman','riddles','airhockey','bazooka']; }
    function badKey(k) { return k.matches('.*(admin|yomak|ادمن|يومك|الاداره|مشرف).*'); }
    function photoOk(d) { return !('photo' in d) || (d.photo is string && (d.photo == '' || (d.photo.size() <= 200000 && d.photo.matches('data:image/(jpeg|png|webp);base64,.*')))); }
    function nameOk(n, lo) { return n is string && n.size() >= lo && n.size() <= 16; }
    function friendshipId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function historyWinnerOk(g, s, w, users) {
      return (g == 'xo' && ((s.winner == 'draw' && w == 'draw') || (s.winner == 'X' && w == s.xUid) || (s.winner == 'O' && w == s.oUid)))
        || (g in ['hangman','riddles'] && (s.winner == w || (s.forfeit is string && s.forfeit != '' && w == (s.forfeit == s.p1 ? s.p2 : s.p1))))
        || (g == 'memory' && ((s.forfeit is string && s.forfeit != '' && w == (s.forfeit == s.p1 ? s.p2 : s.p1)) || ((s.s1 == s.s2) && w == 'draw') || (s.s1 > s.s2 && w == s.p1) || (s.s2 > s.s1 && w == s.p2)))
        || (g == 'chess' && ((s.result == '1-0' && w == s.white) || (s.result == '0-1' && w == s.black) || (s.result == '1/2-1/2' && w == 'draw')))
        || (g == 'airhockey' && ((s.score1 == s.score2 && w == 'draw') || (s.score1 > s.score2 && w == users[0]) || (s.score2 > s.score1 && w == users[1])));
    }

    // كل اسم = مستند معرّفه المفتاح الموحّد (بدون مسافات/حالة حروف) => فريد
    match /usernames/{key} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid','name','active'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.active == true
        && nameOk(request.resource.data.name, 3) && key.size() >= 3 && key.size() <= 32 && !badKey(key)
        && getAfter(pref(request.auth.uid)).data.key == key;
      allow update: if signedIn() && (
        // استلام اسم محجوز لصاحبه أو انتهى حجزه
        (resource.data.active == false && (resource.data.uid == request.auth.uid || resource.data.holdUntil < request.time)
          && request.resource.data.keys().hasOnly(['uid','name','active']) && request.resource.data.uid == request.auth.uid
          && request.resource.data.active == true && nameOk(request.resource.data.name, 3) && !badKey(key)
          && getAfter(pref(request.auth.uid)).data.key == key)
        // تعديل شكل الاسم (حروف كبيرة/صغيرة/مسافات) بنفس المفتاح
        || (resource.data.active == true && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','name','active']) && request.resource.data.uid == request.auth.uid
          && request.resource.data.active == true && nameOk(request.resource.data.name, 3)
          && getAfter(pref(request.auth.uid)).data.key == key)
        // تحرير الاسم القديم مع حجزه 14 يوم
        || (resource.data.active == true && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','name','active','holdUntil']) && request.resource.data.uid == request.auth.uid
          && request.resource.data.active == false && request.resource.data.holdUntil is timestamp
          && request.resource.data.holdUntil >= request.time + duration.value(13, 'd')
          && request.resource.data.holdUntil <= request.time + duration.value(15, 'd')
          && getAfter(pref(request.auth.uid)).data.key != key));
    }

    match /profiles/{uid} {
      allow get: if signedIn();
      allow create: if request.auth.uid == uid && request.resource.data.keys().hasOnly(['username','key','changedAt','photo']) && photoOk(request.resource.data)
        && nameOk(request.resource.data.username, 3) && request.resource.data.changedAt == request.time
        && getAfter(uref(request.resource.data.key)).data.uid == uid && getAfter(uref(request.resource.data.key)).data.active == true
        && getAfter(uref(request.resource.data.key)).data.name == request.resource.data.username;
      // تغيير الاسم مرة كل 30 يوم (مفروض من القواعد نفسها)
      allow update: if request.auth.uid == uid && request.resource.data.keys().hasOnly(['username','key','changedAt','photo']) && photoOk(request.resource.data)
        && nameOk(request.resource.data.username, 3) && request.resource.data.changedAt == request.time
        && resource.data.changedAt + duration.value(30, 'd') <= request.time
        && getAfter(uref(request.resource.data.key)).data.uid == uid && getAfter(uref(request.resource.data.key)).data.active == true
        && getAfter(uref(request.resource.data.key)).data.name == request.resource.data.username
        && (request.resource.data.key == resource.data.key || getAfter(uref(resource.data.key)).data.active == false);
      // تغيير الصورة بس (من غير قيد الـ 30 يوم)
      allow update: if request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo'])
        && request.resource.data.photo is string && photoOk(request.resource.data);
    }

    match /friendships/{fid} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['users','from','status','createdAt','updatedAt'])
        && request.resource.data.users.size() == 2 && request.auth.uid in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && fid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.from == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && request.auth.uid in resource.data.users && resource.data.status == 'pending'
        && resource.data.from != request.auth.uid && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // اسم اللاعب داخل كل لعبة: فريد داخل اللعبة، يتغيّر في أي وقت
    match /gameNames/{gid} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['uid','game','name','photo']) && photoOk(request.resource.data)
        && request.resource.data.uid == request.auth.uid && okGame(request.resource.data.game)
        && nameOk(request.resource.data.name, 2) && gid.matches(request.resource.data.game + '_.+')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/gameprofile/$(request.resource.data.game)).data.nameId == gid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo'])
        && request.resource.data.photo is string && photoOk(request.resource.data);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /users/{userId}/gameprofile/{game} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId && okGame(game)
        && request.resource.data.keys().hasOnly(['name','nameId','updatedAt','photo']) && photoOk(request.resource.data) && nameOk(request.resource.data.name, 2)
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/gameNames/$(request.resource.data.nameId)).data.uid == userId
        && getAfter(/databases/$(database)/documents/gameNames/$(request.resource.data.nameId)).data.game == game;
      allow update: if request.auth != null && request.auth.uid == userId && okGame(game)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photo']) && request.resource.data.photo is string && photoOk(request.resource.data);
    }

    // حضور اللاعبين: الحالة للعرض فقط وليست مصدراً موثوقاً للصلاحيات.
    match /gamePresence/{uid} {
      allow get: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['online','page','game','lastSeen'])
        && request.resource.data.online is bool && request.resource.data.page is string
        && request.resource.data.page.size() <= 40 && request.resource.data.game is string
        && request.resource.data.game.size() <= 40 && request.resource.data.lastSeen == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['online','page','game','lastSeen'])
        && request.resource.data.online is bool && request.resource.data.page is string
        && request.resource.data.page.size() <= 40 && request.resource.data.game is string
        && request.resource.data.game.size() <= 40 && request.resource.data.lastSeen == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // دعوات تحدي صديق داخل لعبة وغرفة محددة.
    match /gameInvites/{inviteId} {
      allow get, list: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from','to','game','roomCode','status','createdAt','updatedAt'])
        && request.resource.data.from == request.auth.uid && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid && okGame(request.resource.data.game)
        && request.resource.data.roomCode is string && request.resource.data.roomCode.matches('[A-Z2-9]{6}')
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/friendships/$(friendshipId(request.auth.uid, request.resource.data.to))).data.status == 'accepted'
        && request.resource.data.to in get(/databases/$(database)/documents/friendships/$(friendshipId(request.auth.uid, request.resource.data.to))).data.users
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.host == request.auth.uid
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.game == request.resource.data.game
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.players == [request.auth.uid]
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.max == 2
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.status == 'open';
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && ((request.auth.uid == resource.data.to && resource.data.status == 'pending' && request.resource.data.status in ['accepted','declined']
              && (request.resource.data.status != 'accepted' || get(/databases/$(database)/documents/rooms/$(resource.data.roomCode)).data.status == 'open'
                && get(/databases/$(database)/documents/rooms/$(resource.data.roomCode)).data.players.size() < get(/databases/$(database)/documents/rooms/$(resource.data.roomCode)).data.max))
          || (request.auth.uid == resource.data.from && resource.data.status == 'pending' && request.resource.data.status == 'cancelled'));
      allow delete: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // سجل نتائج المباريات: إنشاء مرة واحدة بعد انتهاء حالة اللعبة، والقراءة للمشاركين فقط.
    match /gameHistory/{historyId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomCode','game','users','names','round','winner','result','playedAt'])
        && request.resource.data.roomCode is string && request.resource.data.roomCode.matches('[A-Z2-9]{6}')
        && historyId.matches(request.resource.data.roomCode + '_[0-9]+')
        && request.resource.data.game is string && okGame(request.resource.data.game)
        && request.resource.data.users is list && request.resource.data.users.size() >= 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.round is int && request.resource.data.round >= 1
        && request.resource.data.winner is string && request.resource.data.winner.size() <= 128
        && (request.resource.data.winner == 'draw' || request.resource.data.winner in request.resource.data.users)
        && request.resource.data.result is string && request.resource.data.result.size() <= 80
        && request.resource.data.names is map && request.resource.data.playedAt == request.time
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.game == request.resource.data.game
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)).data.players == request.resource.data.users
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)/game/state).data.status == 'over'
        && ((get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)/game/state).data.round is int
              && get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)/game/state).data.round == request.resource.data.round)
          || (!('round' in get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)/game/state).data) && request.resource.data.round == 1))
        && historyWinnerOk(request.resource.data.game, get(/databases/$(database)/documents/rooms/$(request.resource.data.roomCode)/game/state).data, request.resource.data.winner, request.resource.data.users);
      allow update, delete: if false;
    }

    // ---- غرف اللعب الأونلاين + شات الغرفة ----
    match /rooms/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('[A-Z2-9]{6}')
        && request.resource.data.keys().hasOnly(['game','host','players','names','max','status','createdAt'])
        && request.resource.data.host == request.auth.uid && request.resource.data.players == [request.auth.uid]
        && okGame(request.resource.data.game) && request.resource.data.max is int && request.resource.data.max >= 2 && request.resource.data.max <= 4
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && request.resource.data.names[request.auth.uid] == get(/databases/$(database)/documents/users/$(request.auth.uid)/gameprofile/$(request.resource.data.game)).data.name;
      allow update: if signedIn() && (
        // انضمام
        (resource.data.status == 'open' && !(request.auth.uid in resource.data.players) && resource.data.players.size() < resource.data.max
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players','names'])
          && request.resource.data.players == resource.data.players.concat([request.auth.uid])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.names[request.auth.uid] == get(/databases/$(database)/documents/users/$(request.auth.uid)/gameprofile/$(resource.data.game)).data.name)
        // مغادرة لاعب (مش المضيف)
        || (request.auth.uid in resource.data.players && request.auth.uid != resource.data.host
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players','names'])
          && request.resource.data.players == resource.data.players.removeAll([request.auth.uid])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid]))
        // المضيف يقفل الغرفة
        || (request.auth.uid == resource.data.host && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'closed'));
      allow delete: if signedIn() && resource.data.host == request.auth.uid;

      // ---- حالة لعبة الشطرنج الأونلاين (مستند واحد 'state' لكل غرفة) ----
      match /game/{gid} {
        function rm() { return get(/databases/$(database)/documents/rooms/$(code)).data; }
        function mem() { return signedIn() && request.auth.uid in rm().players; }
        function gkeys() { return ['white','black','moves','turn','tc','wms','bms','status','result','reason','drawBy','n','at']; }
        allow read: if mem();
        allow create: if mem() && gid == 'state' && rm().host == request.auth.uid && rm().players.size() == 2 && (
          // الشطرنج
          (rm().game == 'chess' && request.resource.data.keys().hasOnly(gkeys())
            && request.resource.data.white in rm().players && request.resource.data.black in rm().players
            && request.resource.data.white != request.resource.data.black
            && request.resource.data.moves == [] && request.resource.data.status == 'active' && request.resource.data.turn == 'w')
          // XO
          || (rm().game == 'xo' && request.resource.data.keys().hasOnly(['xUid','oUid','board','turn','status','winner','sx','so','sd','round','at','forfeit'])
            && request.resource.data.xUid in rm().players && request.resource.data.oUid in rm().players && request.resource.data.xUid != request.resource.data.oUid
            && request.resource.data.board is list && request.resource.data.board.size() == 9 && request.resource.data.turn == 'X' && request.resource.data.status == 'active')
          // تطابق الكروت
          || (rm().game == 'memory' && request.resource.data.keys().hasOnly(['p1','p2','deck','matched','picks','turn','s1','s2','status','round','at','forfeit'])
            && request.resource.data.p1 in rm().players && request.resource.data.p2 in rm().players && request.resource.data.p1 != request.resource.data.p2
            && request.resource.data.deck is list && request.resource.data.deck.size() == 16 && request.resource.data.matched == [] && request.resource.data.picks == []
            && request.resource.data.turn in [1,2] && request.resource.data.status == 'active')
          // Stickman Fight
          || (rm().game == 'stickman' && request.resource.data.keys().hasOnly(['p1','p2','status','winner','round','at','forfeit'])
            && request.resource.data.p1 is map && request.resource.data.p2 is map
            && request.resource.data.p1.uid in rm().players && request.resource.data.p2.uid in rm().players
            && request.resource.data.p1.uid != request.resource.data.p2.uid && request.resource.data.status == 'active')
          // Hangman
          || (rm().game == 'hangman' && request.resource.data.keys().hasOnly(['p1','p2','word','guessed','wrong','turn','s1','s2','status','winner','round','at','forfeit'])
            && request.resource.data.p1 in rm().players && request.resource.data.p2 in rm().players && request.resource.data.p1 != request.resource.data.p2
            && request.resource.data.word is string && request.resource.data.guessed is list && request.resource.data.wrong is int && request.resource.data.wrong >= 0 && request.resource.data.wrong <= 6
            && request.resource.data.turn in rm().players && request.resource.data.status in ['active','over'])
          // Riddles
          || (rm().game == 'riddles' && request.resource.data.keys().hasOnly(['p1','p2','idx','question','answer','s1','s2','answered','first','winner','status','round','at','forfeit'])
            && request.resource.data.p1 in rm().players && request.resource.data.p2 in rm().players && request.resource.data.p1 != request.resource.data.p2
            && request.resource.data.question is string && request.resource.data.answer is string && request.resource.data.answered is list && request.resource.data.answered.size() <= 2
            && request.resource.data.status in ['active','over'])
          // Air hockey
          || (rm().game == 'airhockey' && request.resource.data.keys().hasOnly(['p1','p2','ball','score1','score2','input1','input2','status','round','at','forfeit'])
            && request.resource.data.p1 is map && request.resource.data.p2 is map && request.resource.data.ball is map
            && request.resource.data.input1 is map && request.resource.data.input2 is map
            && request.resource.data.score1 is int && request.resource.data.score1 >= 0 && request.resource.data.score1 <= 5
            && request.resource.data.score2 is int && request.resource.data.score2 >= 0 && request.resource.data.score2 <= 5
            && request.resource.data.status in ['active','over'])
          // كورة الهبل 2D
          || (rm().game == 'soccer' && request.resource.data.keys().hasOnly(['p1','p2','ball','score1','score2','input1','input2','status','round','at','forfeit'])
            && request.resource.data.p1 is map && request.resource.data.p2 is map && request.resource.data.ball is map
            && request.resource.data.p1.keys().hasOnly(['x','y','vy']) && request.resource.data.p2.keys().hasOnly(['x','y','vy'])
            && request.resource.data.ball.keys().hasOnly(['x','y','vx','vy'])
            && request.resource.data.input1 is map && request.resource.data.input2 is map
            && request.resource.data.input1.keys().hasOnly(['left','right','jump','kick']) && request.resource.data.input2.keys().hasOnly(['left','right','jump','kick'])
            && request.resource.data.input1.left is bool && request.resource.data.input1.right is bool && request.resource.data.input1.jump is bool
            && request.resource.data.input2.left is bool && request.resource.data.input2.right is bool && request.resource.data.input2.jump is bool
            && request.resource.data.score1 is int && request.resource.data.score1 >= 0 && request.resource.data.score1 <= 5
            && request.resource.data.score2 is int && request.resource.data.score2 >= 0 && request.resource.data.score2 <= 5
            && request.resource.data.status in ['active','over'] && request.resource.data.round is int));
        allow update: if mem() && gid == 'state' && (
          // حركات الشطرنج
          (rm().game == 'chess' && ((resource.data.status == 'active'
            && ((resource.data.turn == 'w' && request.auth.uid == resource.data.white) || (resource.data.turn == 'b' && request.auth.uid == resource.data.black))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moves','turn','wms','bms','status','result','reason','drawBy','at'])
            && request.resource.data.moves.size() == resource.data.moves.size() + 1 && request.resource.data.moves.size() <= 600
            && request.resource.data.turn != resource.data.turn)
          || (resource.data.status == 'active' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','result','reason','drawBy','at'])
            && request.resource.data.status in ['active','over'])
          || (resource.data.status == 'over' && request.resource.data.keys().hasOnly(gkeys())
            && request.resource.data.status == 'active' && request.resource.data.moves == [] && request.resource.data.turn == 'w'
            && request.resource.data.n == resource.data.n + 1)))
          // XO: أعضاء الغرفة فقط، واللوحة والنتيجة في مستند معروف الحقول
          || (rm().game == 'xo' && request.resource.data.keys().hasOnly(['xUid','oUid','board','turn','status','winner','sx','so','sd','round','at','forfeit'])
            && request.resource.data.xUid == resource.data.xUid && request.resource.data.oUid == resource.data.oUid
            && request.resource.data.board is list && request.resource.data.board.size() == 9 && request.resource.data.turn in ['X','O']
            && request.resource.data.status in ['active','over'])
          // الذاكرة: تحديثات اللعبة لا تخرج عن مخططها
          || (rm().game == 'memory' && request.resource.data.keys().hasOnly(['p1','p2','deck','matched','picks','turn','s1','s2','status','round','at','forfeit'])
            && request.resource.data.p1 == resource.data.p1 && request.resource.data.p2 == resource.data.p2
            && request.resource.data.deck == resource.data.deck && request.resource.data.matched is list && request.resource.data.matched.size() <= 16
            && request.resource.data.picks is list && request.resource.data.picks.size() <= 2 && request.resource.data.turn in [1,2]
            && request.resource.data.status in ['active','over'])
          // Stickman: كل لاعب يحدّث بيانات شخصيته فقط
          || (rm().game == 'stickman' && request.resource.data.keys().hasOnly(['p1','p2','status','winner','round','at','forfeit'])
            && ((request.auth.uid == resource.data.p1.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p1','status','winner','at'])
                && request.resource.data.p1.uid == request.auth.uid && request.resource.data.p2 == resource.data.p2)
              || (request.auth.uid == resource.data.p2.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p2','status','winner','at'])
                && request.resource.data.p2.uid == request.auth.uid && request.resource.data.p1 == resource.data.p1)
              || (request.auth.uid == rm().host && resource.data.status == 'over'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p1','p2','status','winner','round','at','forfeit'])
                && request.resource.data.status == 'active' && request.resource.data.round == resource.data.round + 1
                && request.resource.data.p1.uid == resource.data.p1.uid && request.resource.data.p2.uid == resource.data.p2.uid))
            && request.resource.data.status in ['active','over'])
          // Hangman: أعضاء الغرفة فقط وتحديث حقول اللعبة
          || (rm().game == 'hangman' && request.resource.data.keys().hasOnly(['p1','p2','word','guessed','wrong','turn','s1','s2','status','winner','round','at','forfeit'])
            && request.resource.data.p1 == resource.data.p1 && request.resource.data.p2 == resource.data.p2
            && request.resource.data.word is string && request.resource.data.guessed is list && request.resource.data.guessed.size() <= 35
            && request.resource.data.wrong is int && request.resource.data.wrong >= 0 && request.resource.data.wrong <= 6
            && request.resource.data.turn in rm().players && request.resource.data.status in ['active','over'])
          // Riddles: synchronize same question and first correct answer
          || (rm().game == 'riddles' && request.resource.data.keys().hasOnly(['p1','p2','idx','question','answer','s1','s2','answered','first','winner','status','round','at','forfeit'])
            && request.resource.data.p1 == resource.data.p1 && request.resource.data.p2 == resource.data.p2
            && request.resource.data.question is string && request.resource.data.answer is string
            && request.resource.data.answered is list && request.resource.data.answered.size() <= 2
            && request.resource.data.status in ['active','over'])
          // Air hockey: host syncs physics; guest syncs their input
          || (rm().game == 'airhockey' && request.resource.data.keys().hasOnly(['p1','p2','ball','score1','score2','input1','input2','status','round','at','forfeit'])
            && ((request.auth.uid == rm().host
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p1','p2','ball','score1','score2','input1','input2','status','round','at','forfeit'])
              && request.resource.data.p1 is map && request.resource.data.p2 is map && request.resource.data.ball is map
              && request.resource.data.score1 is int && request.resource.data.score1 >= 0 && request.resource.data.score1 <= 5
              && request.resource.data.score2 is int && request.resource.data.score2 >= 0 && request.resource.data.score2 <= 5
              && request.resource.data.status in ['active','over'])
            || (request.auth.uid == rm().players[1] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['input2','at'])
              && request.resource.data.input2 is map && request.resource.data.input2.keys().hasOnly(['left','right','up','down'])
              && request.resource.data.input2.left is bool && request.resource.data.input2.right is bool && request.resource.data.input2.up is bool && request.resource.data.input2.down is bool)))
          // Soccer: المضيف يحدّث فيزياء الملعب، والضيف يحدّث أزراره فقط
          || (rm().game == 'soccer' && request.resource.data.keys().hasOnly(['p1','p2','ball','score1','score2','input1','input2','status','round','at','forfeit'])
            && ((request.auth.uid == rm().host
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['p1','p2','ball','score1','score2','input1','input2','status','round','at','forfeit'])
              && request.resource.data.p1 is map && request.resource.data.p2 is map && request.resource.data.ball is map
              && request.resource.data.input1 is map && request.resource.data.input2 is map
              && request.resource.data.score1 is int && request.resource.data.score1 >= 0 && request.resource.data.score1 <= 5
              && request.resource.data.score2 is int && request.resource.data.score2 >= 0 && request.resource.data.score2 <= 5
              && request.resource.data.status in ['active','over'])
            || (request.auth.uid == rm().players[1]
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['input2','at'])
              && request.resource.data.input2 is map
              && request.resource.data.input2.keys().hasOnly(['left','right','jump','kick'])
              && request.resource.data.input2.left is bool && request.resource.data.input2.right is bool && request.resource.data.input2.jump is bool))));
      }

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.players;
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(code)).data.players
          && get(/databases/$(database)/documents/rooms/$(code)).data.status == 'open'
          && request.resource.data.keys().hasOnly(['uid','name','text','at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name == get(/databases/$(database)/documents/rooms/$(code)).data.names[request.auth.uid]
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
          && request.resource.data.at == request.time;
      }
    }
  }
    // غرف Bazooka المستقلة (5-30 لاعبًا). يفضّل لاحقًا نقل اعتماد الحركات الحساسة إلى Cloud Functions.
    match /bazookaRooms/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('[A-Z2-9]{6}')
        && request.resource.data.game == 'bazooka'
        && request.resource.data.host == request.auth.uid
        && request.resource.data.players == [request.auth.uid]
        && request.resource.data.max == 30
        && request.resource.data.status == 'open'
        && request.resource.data.state is map
        && request.resource.data.state.game == 'bazooka'
        && request.resource.data.state.players is list
        && request.resource.data.state.players.size() == 1;
      allow update: if signedIn()
        && (request.auth.uid in resource.data.players || (resource.data.status == 'open' && !(request.auth.uid in resource.data.players) && request.resource.data.players.size() == resource.data.players.size() + 1 && request.auth.uid in request.resource.data.players))
        && request.resource.data.game == 'bazooka'
        && request.resource.data.host == resource.data.host
        && request.resource.data.players is list
        && request.resource.data.players.size() >= 1
        && request.resource.data.players.size() <= 30
        && request.resource.data.state is map
        && request.resource.data.state.game == 'bazooka'
        && request.resource.data.state.players is list
        && request.resource.data.state.players.size() == request.resource.data.players.size()
        && request.resource.data.status in ['open','active','closed'];
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
    }

}
